
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  businessName  String?
  phone         String?
  address       String?
  logoUrl       String?
  signatureUrl  String?
  stampUrl      String?
  plan          Plan          @default(FREE)
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  customers     Customer[]
  invoices      Invoice[]
  subscription  Subscription?
  transactions  Transaction[]
  payouts       Payout[]
  emailVerified Boolean       @default(false)
  image         String?
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  invoiceTemplate InvoiceTemplate @default(CLASSIC)

  // Rekening Bank & E-Wallet Penjual (Direct Transfer & Payout)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccountLocked Boolean   @default(false)
  balance           Decimal   @default(0)

  // Program Referral & Afiliasi
  referralCode      String?   @unique
  referredById      String?
  referredBy        User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals         User[]    @relation("UserReferrals")
  referralRewards   ReferralReward[] @relation("UserReferralRewards")

  // Custom Domain & Subdomain White-Label (PRO)
  customDomain         String?   @unique
  customDomainVerified Boolean   @default(false)
  customDomainTxt      String?
  subdomainSlug        String?   @unique

  // Developer API Keys & Webhooks (PRO)
  apiKeys              ApiKey[]
  webhooks             WebhookEndpoint[]

  @@map("user")
}

model Customer {
  id        String    @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  invoices  Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  publicId       String        @unique @default(cuid())
  userId         String
  customerId     String
  number         String
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  notes          String?
  items          InvoiceItem[]
  subtotal       Decimal       @default(0)
  discountType   String        @default("FIXED")
  discountValue  Decimal       @default(0)
  discountAmount Decimal       @default(0)
  taxRate        Decimal       @default(0)
  taxAmount      Decimal       @default(0)
  total          Decimal       @default(0)
  currency       String        @default("IDR")
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])

  // Opsi & Integrasi Pembayaran
  enableDirectTransfer Boolean   @default(true)
  enableDigitalPayment Boolean   @default(false)
  enableReminder       Boolean   @default(true)
  lastReminderType     String?   // "reminder_h3" | "reminder_today" | "reminder_overdue"
  lastReminderAt       DateTime?
  mayarPaymentUrl      String?
  mayarPaymentId       String?
  paidAt               DateTime?
  paymentMethod        String?   // "DIRECT_TRANSFER" | "NOTAKU_DIGITAL"

  transactions         Transaction[]

  @@unique([userId, number])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  invoiceId   String?
  payoutId    String?
  type        TransactionType   // "INVOICE_PAYMENT" | "PAYOUT_WITHDRAWAL" | "FEE_DEDUCTION" | "REFUND"
  amount      Decimal           // Nominal bersih yang menambah/mengurangi saldo
  grossAmount Decimal           @default(0) // Nominal kotor invoice
  feeAmount   Decimal           @default(0) // Biaya MDR 0.7% atau biaya admin
  description String
  referenceId String?           // ID pembayaran Mayar / ID penarikan
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payout      Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("transaction")
}

model Payout {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       // Nominal yang ditarik user
  feeAmount     Decimal       @default(0) // Biaya transfer / admin jika ada
  netAmount     Decimal       // Nominal bersih yang ditransfer ke rekening user
  bankName      String
  accountNumber String
  accountName   String
  status        PayoutStatus  @default(PENDING)
  notes         String?
  adminNotes    String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payout")
}

model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String
  amount         Decimal   @default(10000)
  status         String    @default("COMPLETED") // "COMPLETED" | "REJECTED" | "PENDING"
  notes          String?
  createdAt      DateTime  @default(now())

  referrer       User      @relation("UserReferralRewards", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredUserId])
  @@index([createdAt])
  @@map("referral_reward")
}

enum TransactionType {
  INVOICE_PAYMENT
  PAYOUT_WITHDRAWAL
  FEE_DEDUCTION
  REFUND
  REFERRAL_REWARD
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  price       Decimal
  amount      Decimal
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  midtransOrderId  String?
  status           SubStatus @default(INACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
}

enum InvoiceTemplate {
    CLASSIC
    MODERN
    MINIMAL
  }

enum Plan {
  FREE
  PRO
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum SubStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  detail    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_log")
}

enum Role {
  USER
  ADMIN
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_view")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String    // e.g. "ntk_live_abcd..." (first 12 chars visible for display)
  keyHash     String    @unique // SHA-256 hash of full API key
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_key")
}

model WebhookEndpoint {
  id          String        @id @default(cuid())
  userId      String
  url         String
  secret      String        // Signing secret: whsec_...
  events      String[]      // ["invoice.created", "invoice.paid", "invoice.overdue"]
  isActive    Boolean       @default(true)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  logs        WebhookLog[]

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_endpoint")
}

model WebhookLog {
  id          String          @id @default(cuid())
  endpointId  String
  event       String          // e.g. "invoice.paid"
  payload     Json
  statusCode  Int?
  response    String?
  durationMs  Int?
  success     Boolean         @default(false)
  createdAt   DateTime        @default(now())

  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([createdAt])
  @@map("webhook_log")
}